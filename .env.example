# All variables are OPTIONAL. SPLICE works fully with an empty .env.
PORT=3001
SPLICE_SCRATCH=/tmp/splice
FILE_TTL_MIN=45
MAX_UPLOAD_GB=2
MAX_CONCURRENT=1

