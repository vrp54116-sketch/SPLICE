{
  "name": "splice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SPLICE — free-forever AI long-video to shorts studio with CLAIM SHIELD.",
  "scripts": {
    "postinstall": "node scripts/synth-music.mjs",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:web": "tsc -p tsconfig.json --noEmit && vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "NODE_ENV=production node dist-server/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.1.0",
    "@fastify/static": "^8.2.0",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@fontsource-variable/space-grotesk": "^5.2.6",
    "@fontsource-variable/unbounded": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@formkit/auto-animate": "^0.9.0",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "cmdk": "^1.1.1",
    "fastify": "^5.3.3",
    "gsap": "^3.13.0",
    "idb-keyval": "^6.2.2",
    "lenis": "^1.3.4",
    "lucide-react": "^0.525.0",
    "motion": "^12.16.0",
    "number-flow": "^0.5.5",
    "p-queue": "^8.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.5",
    "tesseract.js": "^6.0.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.67",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
